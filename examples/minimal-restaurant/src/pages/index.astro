---
import { menu } from '../data/menu';
import { restaurant } from '../data/restaurant';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{restaurant.name}</title>
    <style>
      body { font-family: system-ui, sans-serif; max-width: 720px; margin: 2rem auto; padding: 0 1rem; color: #2a1a10; }
      h1 { font-size: 2rem; margin-bottom: 0.25rem; }
      .tagline { color: #6b5343; margin-top: 0; }
      .hours { background: #f3ead8; padding: 0.75rem 1rem; border-radius: 8px; }
      .category { margin-top: 2rem; }
      .item { display: flex; justify-content: space-between; padding: 0.5rem 0; border-bottom: 1px solid rgba(0,0,0,0.06); }
      .item-name { font-weight: 600; }
      .item-desc { color: #6b5343; font-size: 0.875rem; }
      .price { font-variant-numeric: tabular-nums; color: #c0532b; font-weight: 600; }
      .footer { margin-top: 3rem; font-size: 0.875rem; color: #6b5343; }
      .footer a { color: #c0532b; }
    </style>
  </head>
  <body>
    <h1>{restaurant.name}</h1>
    <p class="tagline">{restaurant.tagline}</p>

    <div class="hours">
      <strong>{restaurant.hoursDisplay.label}:</strong> {restaurant.hoursDisplay.value}
      &nbsp;·&nbsp; {restaurant.phones[0].display}
    </div>

    {menu.map((cat) => (
      <section class="category">
        <h2>{cat.title}</h2>
        {cat.items.map((it) => (
          <div class="item">
            <div>
              <div class="item-name">{it.name}</div>
              {it.description && <div class="item-desc">{it.description}</div>}
            </div>
            <div class="price">${it.price}</div>
          </div>
        ))}
      </section>
    ))}

    <p class="footer">
      Owner: <a href="/pascual">sign in to make changes</a>.
    </p>
  </body>
</html>
