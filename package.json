{
  "name": "@scottynvme/owner-portal",
  "version": "0.2.0",
  "description": "Astro integration that injects a Claude-powered owner-edit portal into a static site",
  "type": "module",
  "license": "MIT",
  "author": "Scott Avedis <scott.avedis@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scottynvme/astro-owner-portal.git"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup && node ./scripts/copy-assets.mjs",
    "prepare": "npm run build",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "release": "changeset publish"
  },
  "peerDependencies": {
    "astro": "^6.0.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.95.1",
    "@octokit/rest": "^22.0.1",
    "bcryptjs": "^3.0.3",
    "jose": "^6.2.3",
    "picomatch": "^4.0.2",
    "sharp": "^0.33.0",
    "zod": "^3.24.1"
  },
  "optionalDependencies": {
    "@upstash/redis": "^1.34.3"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.11",
    "@types/node": "^22.10.0",
    "@types/picomatch": "^3.0.1",
    "astro": "^6.2.2",
    "tsup": "^8.3.5",
    "typescript": "^5.7.0",
    "vitest": "^2.1.8"
  }
}
